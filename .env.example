# Copy this file to ".env" and fill in your own values.
# ".env" is gitignored. Never commit real keys.

# Optional: enables AI title parsing. Without it the tool uses regex cleanup.
ANTHROPIC_API_KEY=

# Where your slskd instance is running, and the API key you set in slskd.yml
SLSKD_URL=http://localhost:5030
SLSKD_API_KEY=
